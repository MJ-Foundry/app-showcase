---
import type { App } from '@lib/apps';
import { relativeDate, isoDate } from '@lib/apps';
import { withBase } from '@lib/url';
import AppIcon from './AppIcon.astro';
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';

/**
 * AppCard — the standard card shown in the "All apps" grid. Carries data-*
 * attributes so the client-side AppExplorer island can filter/sort/search
 * without a framework. Includes a favorites star (persisted to localStorage).
 */
interface Props {
  app: App;
  /** Position used for staggered entrance animation. */
  index?: number;
}
const { app, index = 0 } = Astro.props;
const d = app.data;
const href = withBase(`/apps/${app.id}`);
const delay = Math.min(index, 6);

// Haystack for full-text search (lowercased, joined).
const haystack = [
  d.title, d.tagline, d.description, d.category, d.status, d.access,
  ...d.platforms, ...d.languages, ...d.tech, ...d.tags,
].join(' ').toLowerCase();
---

<article
  class="app-card card card-hover on-scroll group relative flex flex-col p-5"
  style={`transition-delay:${delay * 60}ms`}
  data-app
  data-id={app.id}
  data-title={d.title}
  data-category={d.category}
  data-status={d.status}
  data-access={d.access}
  data-featured={String(d.featured)}
  data-platforms={d.platforms.join('|')}
  data-languages={d.languages.join('|')}
  data-updated={d.updated.getTime()}
  data-haystack={haystack}
>
  <!-- Favorite toggle -->
  <button
    type="button"
    class="fav-btn"
    data-fav={app.id}
    aria-pressed="false"
    aria-label={`Add ${d.title} to favorites`}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M12 17.3l-5.2 3 1-5.8-4.2-4.1 5.9-.9L12 4.2l2.5 5.3 5.9.9-4.2 4.1 1 5.8z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </svg>
  </button>

  <a href={href} class="flex flex-1 flex-col focus:outline-none">
    <div class="mb-4 flex items-start gap-3">
      <AppIcon icon={d.icon} accent={d.accent} size="h-12 w-12 text-xl" />
      <div class="min-w-0 pt-0.5">
        <h3 class="truncate text-lg font-semibold tracking-tight text-[var(--color-ink)]">
          {d.title}
        </h3>
        <p class="mt-0.5 text-sm text-[var(--color-faint)]">{d.category}</p>
      </div>
    </div>

    <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-[var(--color-muted)]">
      {d.description}
    </p>

    <div class="mb-4 flex flex-wrap gap-1.5">
      {d.tags.slice(0, 3).map((t) => <Tag>{t}</Tag>)}
    </div>

    <!-- Footer meta pinned to the bottom -->
    <div class="mt-auto flex items-center justify-between border-t border-[var(--color-line)] pt-3">
      <div class="flex flex-wrap gap-1">
        {d.tech.slice(0, 2).map((t) => <Tag variant="accent">{t}</Tag>)}
      </div>
      <div class="flex items-center gap-2">
        <StatusBadge status={d.status} />
      </div>
    </div>
    <p class="mt-3 text-xs text-[var(--color-faint)]">
      Updated <time datetime={isoDate(d.updated)}>{relativeDate(d.updated)}</time>
    </p>
  </a>
</article>

<style>
  .app-card { scroll-margin-top: 6rem; }

  .fav-btn {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    width: 2rem;
    border-radius: 999px;
    color: var(--color-faint);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    border: 1px solid var(--color-line);
    transition: color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .fav-btn:hover { color: var(--color-coral-500); transform: scale(1.08); }
  .fav-btn[aria-pressed='true'] {
    color: var(--color-coral-500);
  }
  .fav-btn[aria-pressed='true'] svg path {
    fill: var(--color-coral-400);
    stroke: var(--color-coral-500);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
