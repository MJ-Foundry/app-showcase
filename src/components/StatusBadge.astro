---
/**
 * StatusBadge — a colored pill communicating an app's development status.
 * Color carries meaning but is always paired with text + a dot for
 * accessibility (never color alone).
 */
interface Props {
  status: 'Live' | 'Coming Soon';
  class?: string;
}
const { status, class: className = '' } = Astro.props;

const styles: Record<Props['status'], string> = {
  Live: 'bg-[var(--color-mint-100)] text-[var(--color-mint-600)]',
  'Coming Soon': 'bg-iris-100 text-iris-700',
};
---

<span class:list={['pill', styles[status], className]}>
  <span class="dot" aria-hidden="true"></span>
  {status}
</span>

<style>
  .dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
    flex: none;
  }
</style>
