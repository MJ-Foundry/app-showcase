---
import { SITE } from '@lib/site';
import { withBase } from '@lib/url';
import ThemeToggle from './ThemeToggle.astro';

/**
 * Nav — sticky, translucent navigation bar with logo, primary links, a
 * command-palette trigger, theme toggle and a full mobile menu.
 */
const links = [
  { label: 'Apps', href: withBase('/apps') },
  { label: 'About', href: withBase('/about') },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => current === href.replace(/\/$/, '');
---

<header class="site-nav" data-nav>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <!-- Logo -->
    <a href={withBase('/')} class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="20" height="20">
          <path d="M16 3l3.6 8.8L28 15l-8.4 3.2L16 27l-3.6-8.8L4 15l8.4-3.2z" fill="url(#lg)" />
          <defs>
            <linearGradient id="lg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop stop-color="#6440dd" /><stop offset="1" stop-color="#f95f34" />
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="text-[0.98rem] font-semibold tracking-tight">
        {SITE.name}
      </span>
    </a>

    <!-- Desktop links -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['nav-link', isActive(l.href) && 'nav-link--active']}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-1.5">
      <button
        type="button"
        class="cmdk-trigger hidden items-center gap-2 sm:inline-flex"
        data-cmdk-open
        aria-label="Open command palette"
      >
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
          <path d="M8.5 3.5a2 2 0 10-2 2h2v-2zm3 0v2h2a2 2 0 10-2-2zm2 11a2 2 0 102 2v-2h-2zm-9 0h2v2a2 2 0 11-2-2zm2-6h6v6h-6z" fill="none" stroke="currentColor" stroke-width="1.4"/>
        </svg>
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>

      <ThemeToggle />

      <!-- Mobile menu toggle -->
      <button
        type="button"
        class="icon-btn md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path class="line-top" d="M4 7h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path class="line-mid" d="M4 12h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path class="line-bot" d="M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="mobile-menu" data-menu hidden>
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
      {links.map((l) => (
        <a href={l.href} class="mobile-link">{l.label}</a>
      ))}
      <button type="button" class="mobile-link text-left" data-cmdk-open>Search apps ⌘K</button>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-canvas) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .site-nav[data-scrolled] {
    border-color: var(--color-line);
    background: color-mix(in srgb, var(--color-canvas) 92%, transparent);
  }

  .logo-mark {
    display: inline-grid;
    place-items: center;
    height: 2rem;
    width: 2rem;
    border-radius: 0.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    transition: transform 0.3s ease;
  }
  a:hover > .logo-mark { transform: rotate(-8deg) scale(1.05); }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav-link:hover { color: var(--color-ink); background: var(--color-iris-50); }
  .nav-link--active { color: var(--color-iris-700); }

  .cmdk-trigger {
    padding: 0.42rem 0.7rem 0.42rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.85rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .cmdk-trigger:hover { border-color: var(--color-iris-300); color: var(--color-ink); }
  .cmdk-trigger kbd {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0.35rem;
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    color: var(--color-faint);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    height: 2.4rem;
    width: 2.4rem;
    border-radius: 999px;
    color: var(--color-ink);
    transition: background 0.2s ease;
  }
  .icon-btn:hover { background: var(--color-iris-50); }
  .icon-btn svg path { transition: transform 0.3s ease, opacity 0.2s ease; transform-origin: center; }
  .icon-btn[aria-expanded='true'] .line-top { transform: translateY(5px) rotate(45deg); }
  .icon-btn[aria-expanded='true'] .line-mid { opacity: 0; }
  .icon-btn[aria-expanded='true'] .line-bot { transform: translateY(-5px) rotate(-45deg); }

  .mobile-menu {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
    overflow: hidden;
    animation: fade-in 0.25s ease;
  }
  .mobile-link {
    padding: 0.85rem 0.25rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .mobile-link:last-child { border-bottom: none; }
</style>

<script>
  // Sticky-nav shadow on scroll
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.setAttribute('data-scrolled', '');
    else nav.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
  // Close mobile menu when a link is tapped
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (menu) menu.hidden = true;
    })
  );
</script>
