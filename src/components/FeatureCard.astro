---
import type { App } from '@lib/apps';
import { withBase } from '@lib/url';
import AppIcon from './AppIcon.astro';
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';

/**
 * FeatureCard — a large, expressive card for the homepage "Featured" section.
 */
interface Props {
  app: App;
  index?: number;
}
const { app, index = 0 } = Astro.props;
const d = app.data;
const href = withBase(`/apps/${app.id}`);
const [from, to] = d.accent;
const delay = Math.min(index, 6);
---

<article
  class="feature-card card card-hover on-scroll group relative overflow-hidden p-6 md:p-8"
  style={`--from:${from}; --to:${to}; transition-delay:${delay * 80}ms`}
>
  <!-- decorative accent glow -->
  <div class="feature-glow" aria-hidden="true"></div>

  <div class="relative flex flex-col gap-5">
    <div class="flex items-center justify-between gap-3">
      <AppIcon icon={d.icon} accent={d.accent} size="h-16 w-16 text-3xl" />
      <StatusBadge status={d.status} />
    </div>

    <div>
      <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-faint)]">
        <span>{d.category}</span>
        <span aria-hidden="true">·</span>
        <span>{d.access}</span>
      </div>
      <h3 class="text-2xl font-semibold tracking-tight md:text-[1.65rem]">
        {d.title}
      </h3>
      <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
        {d.tagline}
      </p>
    </div>

    <div class="flex flex-wrap gap-1.5">
      {d.tags.slice(0, 4).map((t) => <Tag>{t}</Tag>)}
    </div>

    <a
      href={href}
      class="inline-flex items-center gap-1.5 self-start text-sm font-semibold text-iris-600 transition-colors hover:text-iris-700"
    >
      Explore {d.title}
      <svg class="arrow" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <!-- full-card link overlay for large hit target (kept below the CTA/tags visually) -->
  <a href={href} class="absolute inset-0" aria-label={`Explore ${d.title}`} tabindex="-1"></a>
</article>

<style>
  .feature-glow {
    position: absolute;
    top: -40%;
    right: -20%;
    width: 60%;
    height: 120%;
    background: radial-gradient(circle, color-mix(in srgb, var(--from) 22%, transparent), transparent 70%);
    filter: blur(10px);
    opacity: 0.7;
    transition: opacity 0.5s ease, transform 0.6s ease;
    pointer-events: none;
  }
  .feature-card:hover .feature-glow { opacity: 1; transform: translate(-6%, 4%); }
  .arrow { transition: transform 0.25s ease; }
  .feature-card:hover .arrow { transform: translateX(3px); }
  /* keep interactive elements above the overlay link */
  .feature-card :global(a:not(.absolute)),
  .feature-card :global(.pill) { position: relative; z-index: 1; }
</style>
