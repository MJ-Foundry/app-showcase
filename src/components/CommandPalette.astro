---
import { getApps } from '@lib/apps';
import { withBase } from '@lib/url';

/**
 * CommandPalette — a ⌘K / Ctrl+K quick-launcher. Fully client-side: the app
 * index is inlined as data attributes and filtered with vanilla JS. Opened
 * from any `[data-cmdk-open]` trigger, closed with Escape / backdrop click.
 */
const apps = await getApps();
const items = [
  { id: '__apps', title: 'Browse all apps', hint: 'Page', href: withBase('/apps'), icon: '▤', accent: ['#7658f0', '#937bfb'] as [string, string] },
  { id: '__about', title: 'About', hint: 'Page', href: withBase('/about'), icon: '☺', accent: ['#1667b8', '#3aa0ff'] as [string, string] },
  ...apps.map((a) => ({
    id: a.id,
    title: a.data.title,
    hint: `${a.data.category} · ${a.data.status}`,
    href: withBase(`/apps/${a.id}`),
    icon: a.data.icon,
    accent: a.data.accent,
  })),
];
---

<div class="cmdk" data-cmdk hidden aria-hidden="true">
  <div class="cmdk__backdrop" data-cmdk-backdrop></div>
  <div class="cmdk__panel" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="cmdk__search">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.7" />
        <path d="M14 14l4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
      <input
        type="text"
        data-cmdk-input
        placeholder="Search apps and pages…"
        aria-label="Search apps and pages"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>esc</kbd>
    </div>

    <ul class="cmdk__list" data-cmdk-list role="listbox" aria-label="Results">
      {items.map((it, i) => (
        <li>
          <a
            href={it.href}
            class="cmdk__item"
            role="option"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-cmdk-item
            data-search={`${it.title} ${it.hint}`.toLowerCase()}
          >
            <span class="cmdk__icon" style={`--from:${it.accent[0]}; --to:${it.accent[1]};`} aria-hidden="true">{it.icon}</span>
            <span class="cmdk__label">{it.title}</span>
            <span class="cmdk__hint">{it.hint}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="cmdk__empty" data-cmdk-empty hidden>No matches. Try another search.</p>
  </div>
</div>

<style>
  .cmdk { position: fixed; inset: 0; z-index: 100; display: grid; place-items: start center; padding-top: 12vh; }
  .cmdk__backdrop { position: absolute; inset: 0; background: color-mix(in srgb, var(--color-ink) 34%, transparent); backdrop-filter: blur(4px); animation: fade-in 0.2s ease; }
  .cmdk__panel {
    position: relative; width: min(38rem, calc(100vw - 2rem));
    background: var(--color-surface); border: 1px solid var(--color-line);
    border-radius: var(--radius-xl); box-shadow: var(--shadow-lift); overflow: hidden;
    animation: fade-up 0.28s cubic-bezier(0.16,1,0.3,1);
  }
  .cmdk__search { display: flex; align-items: center; gap: 0.7rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--color-line); color: var(--color-faint); }
  .cmdk__search input { flex: 1; border: none; outline: none; background: transparent; font-size: 1rem; color: var(--color-ink); }
  .cmdk__search kbd { font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 0.35rem; border: 1px solid var(--color-line); color: var(--color-faint); }
  .cmdk__list { max-height: 22rem; overflow-y: auto; padding: 0.5rem; margin: 0; list-style: none; }
  .cmdk__item { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.7rem; border-radius: 0.8rem; color: var(--color-ink); }
  .cmdk__item[aria-selected='true'] { background: var(--color-iris-50); }
  .cmdk__icon { display: inline-grid; place-items: center; height: 1.9rem; width: 1.9rem; border-radius: 0.55rem; background-image: linear-gradient(135deg, var(--from), var(--to)); color: #fff; font-size: 0.9rem; flex: none; }
  .cmdk__label { font-weight: 500; font-size: 0.95rem; }
  .cmdk__hint { margin-left: auto; font-size: 0.78rem; color: var(--color-faint); }
  .cmdk__empty { padding: 1.5rem; text-align: center; color: var(--color-faint); font-size: 0.9rem; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cmdk]');
  const input = document.querySelector<HTMLInputElement>('[data-cmdk-input]');
  const list = document.querySelector<HTMLElement>('[data-cmdk-list]');
  const empty = document.querySelector<HTMLElement>('[data-cmdk-empty]');
  const backdrop = document.querySelector<HTMLElement>('[data-cmdk-backdrop]');
  let lastFocused: HTMLElement | null = null;

  const items = () => Array.from(document.querySelectorAll<HTMLElement>('[data-cmdk-item]'));
  const visible = () => items().filter((el) => !el.parentElement?.hasAttribute('hidden'));

  function open() {
    if (!root) return;
    lastFocused = document.activeElement as HTMLElement;
    root.hidden = false;
    root.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (input) { input.value = ''; }
    filter('');
    requestAnimationFrame(() => input?.focus());
  }
  function close() {
    if (!root) return;
    root.hidden = true;
    root.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }
  function select(el: HTMLElement | undefined) {
    visible().forEach((i) => i.setAttribute('aria-selected', 'false'));
    if (el) { el.setAttribute('aria-selected', 'true'); el.scrollIntoView({ block: 'nearest' }); }
  }
  function filter(q: string) {
    const query = q.trim().toLowerCase();
    let shown = 0;
    items().forEach((el) => {
      const match = !query || (el.dataset.search ?? '').includes(query);
      el.parentElement!.toggleAttribute('hidden', !match);
      if (match) shown++;
    });
    if (empty) empty.hidden = shown > 0;
    select(visible()[0]);
  }

  input?.addEventListener('input', () => filter(input.value));
  backdrop?.addEventListener('click', close);

  document.querySelectorAll('[data-cmdk-open]').forEach((b) =>
    b.addEventListener('click', open)
  );

  document.addEventListener('keydown', (e) => {
    // Global open shortcut
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      root?.hidden ? open() : close();
      return;
    }
    if (root?.hidden) return;

    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const vis = visible();
      const idx = vis.findIndex((i) => i.getAttribute('aria-selected') === 'true');
      const next = e.key === 'ArrowDown'
        ? Math.min(idx + 1, vis.length - 1)
        : Math.max(idx - 1, 0);
      select(vis[next]);
    } else if (e.key === 'Enter') {
      const active = visible().find((i) => i.getAttribute('aria-selected') === 'true');
      (active as HTMLAnchorElement | undefined)?.click();
    }
  });
</script>
