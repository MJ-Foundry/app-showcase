---
import { SITE } from '@lib/site';
import { withBase } from '@lib/url';

const year = new Date().getFullYear();
const cols = [
  {
    title: 'Browse',
    links: [
      { label: 'All apps', href: withBase('/apps') },
      { label: 'About', href: withBase('/about') },
    ],
  },
  {
    title: 'Connect',
    links: [
      { label: 'GitHub', href: SITE.github, external: true },
      { label: 'Contact', href: SITE.contact, external: true },
    ],
  },
];
---

<footer class="mt-24 border-t border-[var(--color-line)]">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl tracking-tight">{SITE.name} <span class="text-[var(--color-faint)]">/ {SITE.brand}</span></p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-[var(--color-muted)]">
        {SITE.description}
      </p>
    </div>

    {cols.map((col) => (
      <nav aria-label={col.title}>
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-[var(--color-faint)]">{col.title}</h2>
        <ul class="space-y-2">
          {col.links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm text-[var(--color-muted)] transition-colors hover:text-iris-600"
                {...(l.external ? { rel: 'noopener noreferrer', target: '_blank' } : {})}
              >
                {l.label}{l.external ? ' ↗' : ''}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div class="container-page flex flex-col items-center justify-between gap-2 py-5 text-xs text-[var(--color-faint)] sm:flex-row">
      <p>© {year} {SITE.author}. All rights reserved.</p>
      <p class="flex items-center gap-1.5">
        Built with
        <a href="https://astro.build" rel="noopener noreferrer" target="_blank" class="font-medium text-[var(--color-muted)] hover:text-iris-600">Astro</a>
        · Powered by
        <a href="https://pages.github.com" rel="noopener noreferrer" target="_blank" class="font-medium text-[var(--color-muted)] hover:text-iris-600">GitHub Pages</a>
      </p>
    </div>
  </div>
</footer>
