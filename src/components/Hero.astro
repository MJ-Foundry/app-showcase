---
import { withBase } from '@lib/url';

/**
 * Hero — homepage headline with a decorative, animated gradient backdrop.
 * The backdrop is purely decorative (aria-hidden) and disables its animation
 * under prefers-reduced-motion via the global stylesheet.
 */
---

<section class="hero">
  <!-- Decorative animated background -->
  <div class="hero-bg" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="container-page relative">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="reveal text-4xl leading-[1.05] sm:text-5xl md:text-6xl">
        Thoughtful apps<br />
        <span class="text-gradient">for everyday life</span>
      </h1>

      <p class="reveal delay-1 mx-auto mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">
        A living collection of the apps, tools and experiments I build — spanning
        AI, the web and mobile. Browse, search and find something useful.
      </p>

      <div class="reveal delay-2 mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={withBase('/apps')} class="btn btn-primary">
          Explore all apps
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <button type="button" class="btn btn-ghost" data-cmdk-open>
          Quick search
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: 6rem 0 5rem; }
  @media (min-width: 768px) { .hero { padding: 8rem 0 6rem; } }

  .hero-bg { position: absolute; inset: -20% 0 0; z-index: 0; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.55; will-change: transform; }
  .blob-1 { top: 4%; left: 8%; width: 32rem; height: 32rem; background: radial-gradient(circle, var(--color-iris-200), transparent 68%); animation: float-slow 14s ease-in-out infinite; }
  .blob-2 { top: 0; right: 4%; width: 26rem; height: 26rem; background: radial-gradient(circle, var(--color-peach-200), transparent 68%); animation: float-slow 18s ease-in-out infinite reverse; }
  .blob-3 { bottom: -30%; left: 40%; width: 28rem; height: 28rem; background: radial-gradient(circle, var(--color-sky-100), transparent 68%); animation: float-slow 22s ease-in-out infinite; }
  :global([data-theme='dark']) .blob { opacity: 0.22; }

  .grid-overlay {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-ink) 4%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-ink) 4%, transparent) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 30%, transparent 75%);
  }
</style>
