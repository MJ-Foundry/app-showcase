---
import { SITE } from '@lib/site';

/**
 * ContactForm — a short contact form that hands off to the visitor's own
 * mail client via a `mailto:` link, addressed to SITE.contactEmail. This
 * keeps the site 100% static (no backend, no third-party form service or
 * account to provision) while still routing messages to a real inbox.
 */
---

<form class="contact-form card p-6" data-contact-form data-to={SITE.contactEmail} novalidate>
  <div class="field">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="cf-subject">Subject</label>
    <input id="cf-subject" name="subject" type="text" required />
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="5" required></textarea>
  </div>

  <button type="submit" class="btn btn-primary w-full justify-center">Send message</button>
  <p class="contact-hint">We handle your details strictly to answer your message. Read our privacy policy. No marketing consent or registration required.</p>
</form>

<style>
  .contact-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; text-align: left; }
  .field label { font-size: 0.85rem; font-weight: 600; color: var(--color-ink); }
  .field input,
  .field textarea {
    border: 1px solid var(--color-line);
    background: var(--color-canvas);
    border-radius: 0.85rem;
    padding: 0.7rem 0.9rem;
    font: inherit;
    color: var(--color-ink);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    resize: vertical;
  }
  .field input:hover,
  .field textarea:hover { border-color: var(--color-iris-300); }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-iris-400);
    box-shadow: 0 0 0 3px var(--color-iris-100);
  }
  .contact-hint { font-size: 0.8rem; color: var(--color-faint); text-align: center; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const subject = String(data.get('subject') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    const to = (form.dataset.to ?? '').trim();
    const body = `${message}\n\n—\n${name}\n${email}`;

    const mailto = `mailto:${encodeURIComponent(to)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>
