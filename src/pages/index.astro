---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import FeatureCard from '@components/FeatureCard.astro';
import AppCard from '@components/AppCard.astro';
import { getApps, getFeaturedApps } from '@lib/apps';
import { withBase } from '@lib/url';
import { SITE } from '@lib/site';

const apps = await getApps();
const featured = await getFeaturedApps();
// Only surface upcoming apps that aren't already shown above, so the section
// stays useful whether one app is coming or every app is.
const shownAbove = new Set(featured.map((a) => a.id));
const comingSoon = apps.filter(
  (a) => a.data.status === 'Coming Soon' && !shownAbove.has(a.id),
);

// App statistics
const stats = [
  { label: 'Available now', value: apps.filter((a) => a.data.status === 'Live').length },
  { label: 'In the works', value: apps.filter((a) => a.data.status === 'Coming Soon').length },
];
---

<BaseLayout title={SITE.title} path="/">
  <Hero />

  <!-- Statistics -->
  <section class="container-page -mt-4">
    <dl class="stats card on-scroll">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat__label">{s.label}</dt>
          <dd class="stat__value">{s.value}</dd>
        </div>
      ))}
      <div class="stat">
        <dt class="stat__label">Platforms</dt>
        <dd class="stat__value stat__platforms">
          {/* Brand marks via Simple Icons (CC0) — https://simpleicons.org/?q=apple */}
          <span class="platform-icon" role="img" aria-label="Available on the App Store">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
            </svg>
          </span>
          {/* https://simpleicons.org/?q=google-play */}
          <span class="platform-icon" role="img" aria-label="Available on Google Play">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z" />
            </svg>
          </span>
        </dd>
      </div>
    </dl>
  </section>

  <!-- Featured -->
  <section class="container-page mt-24">
    <header class="section-head on-scroll">
      <div>
        <p class="kicker">Spotlight</p>
        <h2 class="text-3xl md:text-4xl">Featured apps</h2>
      </div>
    </header>
    <div class="feature-grid">
      {featured.map((app, i) => <FeatureCard app={app} index={i} />)}
    </div>
  </section>

  <!-- Coming soon -->
  {comingSoon.length > 0 && (
    <section class="container-page mt-24">
      <header class="section-head on-scroll">
        <div>
          <p class="kicker">On the horizon</p>
          <h2 class="text-3xl md:text-4xl">Coming soon</h2>
        </div>
      </header>
      <div class="app-grid">
        {comingSoon.map((app, i) => <AppCard app={app} index={i} />)}
      </div>
    </section>
  )}

  <!-- CTA band -->
  <section class="container-page mt-24">
    <div class="cta on-scroll">
      <div class="cta__glow" aria-hidden="true"></div>
      <h2 class="relative text-3xl md:text-4xl">Find your next favorite tool.</h2>
      <p class="relative mx-auto mt-3 max-w-md text-[var(--color-muted)]">
        Browse the collection or search for something specific.
      </p>
      <div class="relative mt-7 flex flex-wrap justify-center gap-3">
        <a href={withBase('/apps')} class="btn btn-primary">Explore all apps</a>
        <button type="button" class="btn btn-ghost" data-cmdk-open>Quick search</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; padding: 1.5rem 1rem; }
  .stat { text-align: center; padding: 0.5rem; position: relative; }
  .stat:not(:last-child)::after {
    content: ''; position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: var(--color-line);
  }
  .stat__value { font-family: var(--font-display); font-size: 2rem; font-weight: 500; color: var(--color-iris-700); letter-spacing: -0.02em; }
  .stat__label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-faint); margin-bottom: 0.35rem; }
  .stat__platforms { display: flex; align-items: center; justify-content: center; gap: 0.7rem; min-height: 2.5rem; }
  .platform-icon { display: inline-flex; color: var(--color-ink); }

  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; }
  .kicker { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-peach-500); margin-bottom: 0.5rem; }
  .feature-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .app-grid { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }

  .cta {
    position: relative; overflow: hidden; text-align: center;
    padding: 4rem 1.5rem; border-radius: var(--radius-3xl);
    background: var(--color-surface); border: 1px solid var(--color-line); box-shadow: var(--shadow-soft);
  }
  .cta__glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(40rem 20rem at 15% 0%, var(--color-iris-50), transparent 60%),
      radial-gradient(36rem 20rem at 90% 100%, var(--color-peach-50), transparent 60%);
  }
</style>
