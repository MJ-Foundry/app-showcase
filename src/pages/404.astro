---
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@lib/url';
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." path="/404">
  <section class="container-page grid min-h-[60vh] place-items-center py-20 text-center">
    <div class="reveal max-w-md">
      <p class="code" aria-hidden="true">404</p>
      <h1 class="mt-4 text-3xl md:text-4xl">This page wandered off.</h1>
      <p class="mt-3 text-[var(--color-muted)]">
        The link may be broken or the page may have moved. Let's get you back to
        something useful.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase('/')} class="btn btn-primary">Back home</a>
        <a href={withBase('/apps')} class="btn btn-ghost">Browse apps</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .code {
    font-family: var(--font-display); font-size: 5rem; font-weight: 500; line-height: 1;
    background-image: linear-gradient(120deg, var(--color-iris-500), var(--color-coral-400));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
</style>
