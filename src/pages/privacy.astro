---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@lib/site';

// Bump this when the policy text materially changes.
const lastUpdated = 'August 4, 2026';

const sections = [
  {
    heading: 'Introduction',
    body: [
      `This Privacy Policy explains how ${SITE.name} handles information in connection with the mobile applications we publish. We wrote this policy to be as short as it honestly can be — our apps are built to run entirely on your device, and there is very little to explain as a result.`,
    ],
  },
  {
    heading: 'Information We Collect',
    body: [
      'We do not collect any personal information. Our apps do not require you to create an account, and they do not transmit data to us or to any third party, because we operate no servers to receive it.',
      'Anything you create or configure within an app — such as saved settings, preferences, or content — is stored only in local storage on your own device and is never transmitted anywhere.',
    ],
  },
  {
    heading: 'How We Use Information',
    body: [
      'Because we do not collect any information, we do not use, sell, rent, or share any information about you. Where an app uses an on-device capability (for example, adjusting your screen’s brightness) to provide its core functionality, that access happens locally, in the moment, and is never recorded or sent off your device.',
    ],
  },
  {
    heading: 'Third-Party Services',
    body: [
      'Our apps do not integrate analytics, advertising, tracking, or crash-reporting SDKs of any kind.',
      'If you download an app from a store such as Google Play or the Apple App Store, that store may independently collect information under its own privacy policy (for example, download counts or aggregate crash statistics). That collection is governed by the store’s policy, not ours, and we only ever see the aggregate figures the store makes available to any developer.',
    ],
  },
  {
    heading: 'Data Storage and Security',
    body: [
      'Since no information is transmitted to or stored by us, there is no server-side data for us to secure. Data an app stores locally on your device is protected by your device’s own operating system and security features. Uninstalling an app removes its locally stored data.',
    ],
  },
  {
    heading: 'Children’s Privacy',
    body: [
      'Our apps do not knowingly collect personal information from anyone, including children under 13. Because we collect no personal information from any user, none is collected from children either.',
    ],
  },
  {
    heading: 'Your Choices',
    body: [
      'Because no personal information is collected, there is nothing for us to let you access, correct, or delete on your behalf — any data an app holds is already local to your device and fully within your control, including deletion, by uninstalling the app.',
    ],
  },
  {
    heading: 'Changes to This Policy',
    body: [
      'If we release an app that works differently — for example, one that introduces an optional account or sync feature — we will update this policy before that app ships, and revise the date above accordingly.',
    ],
  },
  {
    heading: 'Contact Us',
    body: [
      `If you have questions about this policy, email us at ${SITE.contactEmail}.`,
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${SITE.author} apps handle your data — the short answer is they don’t collect it.`}
  path="/privacy"
>
  <section class="container-page pt-16 pb-4">
    <div class="mx-auto max-w-2xl">
      <p class="kicker">Legal</p>
      <h1 class="mt-3 text-4xl md:text-5xl">Privacy Policy</h1>
      <p class="mt-4 text-sm text-[var(--color-faint)]">Last updated {lastUpdated}</p>
    </div>
  </section>

  <section class="container-page mt-10 pb-8">
    <div class="mx-auto max-w-2xl space-y-10">
      {sections.map((s) => (
        <div>
          <h2 class="text-2xl">{s.heading}</h2>
          {s.body.map((p) => (
            <p class="mt-3 leading-relaxed text-[var(--color-muted)]">{p}</p>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .kicker { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-peach-500); }
</style>
