---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@lib/site';

// Bump this when the policy text materially changes.
const effective = 'August 2, 2026';

const sections = [
  {
    heading: 'The short version',
    body: [
      `${SITE.name} builds local-first apps. Our apps run entirely on your device. They do not require an account, and they do not send your data anywhere — because there is nowhere for it to go. We have no servers that receive your information.`,
    ],
  },
  {
    heading: 'Information we collect',
    body: [
      'None. Our apps do not collect, transmit, or store personal data on any server we control. Anything you create in an app — your saved colors, settings, and preferences — is stored only in the app’s own storage on your device and never leaves it.',
      'We do not use analytics, advertising, tracking SDKs, or crash-reporting services. The apps request no data-related permissions.',
    ],
  },
  {
    heading: 'Softbox specifically',
    body: [
      'Softbox turns your phone into a photographic light. It stores your colors, intensity, favorites, and preferences locally on the device and adjusts your screen brightness while in use. It has no network access and no account. Uninstalling the app removes this locally stored data.',
    ],
  },
  {
    heading: 'App stores',
    body: [
      'When you download an app from a store such as Google Play or the Apple App Store, that store may collect information governed by its own privacy policy (for example, download counts or aggregate crash data). We do not control or receive that information beyond the aggregate figures the store shows any developer.',
    ],
  },
  {
    heading: 'Children’s privacy',
    body: [
      'Our apps do not collect personal information from anyone, including children.',
    ],
  },
  {
    heading: 'Changes to this policy',
    body: [
      'If we release an app that works differently — for example one with an optional account or sync — we will update this policy before that app ships, and note the effective date above.',
    ],
  },
  {
    heading: 'Contact',
    body: [
      `Questions about privacy? Email us at ${SITE.contactEmail}.`,
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${SITE.author} apps handle your data — the short answer is they don’t collect it.`}
  path="/privacy"
>
  <section class="container-page pt-16 pb-4">
    <div class="mx-auto max-w-2xl">
      <p class="kicker">Legal</p>
      <h1 class="mt-3 text-4xl md:text-5xl">Privacy Policy</h1>
      <p class="mt-4 text-sm text-[var(--color-faint)]">Effective {effective}</p>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)]">
        This policy applies to {SITE.name} and all of the apps we publish,
        including Softbox.
      </p>
    </div>
  </section>

  <section class="container-page mt-10 pb-8">
    <div class="mx-auto max-w-2xl space-y-10">
      {sections.map((s) => (
        <div>
          <h2 class="text-2xl">{s.heading}</h2>
          {s.body.map((p) => (
            <p class="mt-3 leading-relaxed text-[var(--color-muted)]">{p}</p>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .kicker { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-peach-500); }
</style>
